# Plantilla de variables de entorno — Vit Cristales
# Copiar a .env y completar con valores reales. NUNCA versionar .env.

# Selección de ambiente: config.settings.development | config.settings.production | config.settings.testing
DJANGO_SETTINGS_MODULE=config.settings.development

# Seguridad (generar un valor largo y aleatorio en producción)
SECRET_KEY=cambiar-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos de producción. En desarrollo se usa SQLite (db.sqlite3).
DATABASE_URL=

# Orígenes CSRF de confianza en producción (separados por coma)
# CSRF_TRUSTED_ORIGINS=https://tu-dominio.onrender.com

# Storage de media compatible con S3 / Supabase (solo producción)
USE_SUPABASE_STORAGE=False
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_BUCKET=
SUPABASE_S3_ENDPOINT=
