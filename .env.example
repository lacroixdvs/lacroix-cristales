# Plantilla de variables de entorno — Vit Cristales
# Copiar a .env y completar con valores reales. NUNCA versionar .env.

# Selección de ambiente: config.settings.development | config.settings.production | config.settings.testing
DJANGO_SETTINGS_MODULE=config.settings.development

# Seguridad (generar un valor largo y aleatorio en producción)
SECRET_KEY=cambiar-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos. En desarrollo se usa SQLite (db.sqlite3).
# En producción/Render lo inyecta el Blueprint; en docker-compose se arma desde POSTGRES_*.
DATABASE_URL=

# Orígenes CSRF de confianza en producción (separados por coma).
# Render acepta comodines: https://*.onrender.com
CSRF_TRUSTED_ORIGINS=

# Render inyecta RENDER_EXTERNAL_HOSTNAME; no hace falta definirlo a mano.
RENDER_EXTERNAL_HOSTNAME=

# Servidor de aplicación (entrypoint.sh usa estas variables)
PORT=8000
WEB_CONCURRENCY=3
WEB_TIMEOUT=120

# Cabeceras de seguridad HTTPS.
# En Render dejar todo en True. Para probar HTTP dentro de Docker local,
# poner SECURE_SSL_REDIRECT=False y las dos cookies en False.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_ENABLED=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# WhiteNoise: Manifest es lo recomendado. Si collectstatic falla por un
# archivo referenciado ausente, cambiar a whitenoise.storage.CompressedStaticFilesStorage
STATICFILES_STORAGE_BACKEND=whitenoise.storage.CompressedManifestStaticFilesStorage

# PostgreSQL local levantado por docker-compose.yml
POSTGRES_DB=vitcristales
POSTGRES_USER=vit
POSTGRES_PASSWORD=cambiar-para-docker-compose

# Usuario administrador inicial (opcional; el entrypoint lo crea si hay ADMIN_PASSWORD)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@vitcristales.local
ADMIN_PASSWORD=

# Storage de media compatible con S3 / Supabase (solo producción).
# Se activa únicamente si USE_SUPABASE_STORAGE=True y las 4 credenciales están completas.
USE_SUPABASE_STORAGE=False
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_BUCKET=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=auto
SUPABASE_S3_LOCATION=media
# URL pública del bucket (sin secretos) para armar MEDIA_URL
SUPABASE_S3_PUBLIC_URL=
